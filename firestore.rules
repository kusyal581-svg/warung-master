rules_version = '2';

// Warung POS - Firestore Security Rules
// Meniru "test mode" Firebase Console dengan masa berlaku, sehingga aplikasi
// kasir bisa jalan tanpa Firebase Auth. WAJIB diganti sebelum dipakai produksi.
service cloud.firestore {
  match /databases/{database}/documents {

    // Produk: dashboard, kasir, dan Manajemen Produk (tambah/edit/hapus).
    match /products/{productId} {
      allow read, write: if request.time < timestamp.date(2027, 1, 1);
    }

    // Riwayat transaksi: dipakai dashboard, tombol Riwayat, dan ekspor CSV.
    match /history/{transactionId} {
      allow read, write: if request.time < timestamp.date(2027, 1, 1);
    }

    // Pengaturan toko: satu dokumen, id = 'store'.
    match /settings/{docId} {
      allow read, write: if request.time < timestamp.date(2027, 1, 1);
    }

    // Koleksi lain: tolak semua.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
